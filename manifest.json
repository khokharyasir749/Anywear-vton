{
  "manifest_version": 3,
  "name": "Anywear VTO - Live Virtual Try-On",
  "version": "1.0.0",
  "description": "Real-time webcam virtual try-on overlay with instant garment picker and low-latency computer vision streaming.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Toggle Anywear VTO Overlay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
